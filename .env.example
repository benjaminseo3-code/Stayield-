# --- App ---
APP_URL=http://localhost:3000
# Domain used for per-property inbound addresses: p-<token>@<INBOUND_DOMAIN>
INBOUND_DOMAIN=inbound.localhost

# --- Database ---
# Empty = embedded PGlite persisted at ./.data/db (local development).
# Hosted Postgres / Supabase (use the transaction pooler, port 6543):
#   postgresql://<role>.<project-ref>:<password>@<pooler-host>:6543/postgres
# All tables live in the "stayield" schema, so the database can be shared with other apps.
DATABASE_URL=
# verify (default, uses certs/supabase-prod-ca-2021.crt) | no-verify | disable
DATABASE_SSL=

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional admin account created by `pnpm db:seed` (never committed or documented elsewhere)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Inbound email (signed income reports) ---
# Shared secret the email provider sends in the x-webhook-secret header. Unset = webhook rejects everything.
INBOUND_WEBHOOK_SECRET=
# TODO(real-sample): confirm the actual sender domain from a real report email.
TRUSTED_SENDER_DOMAINS=airbnb.com

# --- Storage / mail ---
# local (default, ./.data/files) | database (files stored in Postgres; use on serverless hosts)
STORAGE_ADAPTER=local
# log = no email is delivered (nothing is written to disk). Default writes to ./.data/outbox.
MAILER=

# Only for automated tests that sign in many times from one IP. Never set in production.
RATE_LIMIT_DISABLED=
