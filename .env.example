# --- App ---
APP_URL=http://localhost:3000
# Domain used for per-property inbound addresses: p-<token>@<INBOUND_DOMAIN>
INBOUND_DOMAIN=inbound.localhost

# --- Database ---
# Leave empty to use embedded PGlite persisted at ./.data/db.
# Production / Supabase: postgres://user:pass@host:5432/db
DATABASE_URL=

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Comma-separated emails that get the admin role on sign-in
ADMIN_EMAILS=

# --- Inbound email ---
# Shared secret the email provider sends in the x-webhook-secret header.
# If empty the webhook rejects everything (fail closed).
INBOUND_WEBHOOK_SECRET=
# Domains whose DKIM signature we accept as the report issuer.
# TODO(real-sample): confirm the actual sender domain from a real report email.
TRUSTED_SENDER_DOMAINS=airbnb.com

# --- Payments ---
# mock (default) | stripe
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price of a report unlock, in minor units
UNLOCK_PRICE_MINOR=4900
UNLOCK_CURRENCY=USD

# --- Storage ---
# local (default) | s3 (not implemented yet)
STORAGE_ADAPTER=local
